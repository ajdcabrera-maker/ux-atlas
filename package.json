{
  "name": "ux-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "UX skills for agents. Each skill is skills/<name>/SKILL.md.",
  "files": [
    "skills",
    "instructions",
    "scripts"
  ],
  "bin": {
    "ux-atlas": "./scripts/init.mjs"
  },
  "exports": {
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "deploy": "npm --prefix site run deploy",
    "postinstall": "node scripts/init.mjs"
  },
  "dependencies": {
    "ux-atlas": "github:ajdcabrera-maker/ux-atlas"
  },
  "allowScripts": {
    "github:ajdcabrera-maker/ux-atlas#3f596600178c99b256fa1d60f450b21dff2e2eb0": true
  }
}
