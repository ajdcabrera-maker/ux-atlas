---
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
import Surface from '../ds/Surface.astro';

const docs = (await getCollection('docs')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const sections = [
  { id: 'foundations', label: 'Foundations' },
  { id: 'patterns', label: 'Patterns' },
  { id: 'components', label: 'Components' },
  { id: 'design-ops', label: 'Design Ops' },
];
---

<SiteLayout
  title={site.name}
  description="Machine-readable UX documentation for designers and agents. Companion to aarondesign.rocks."
>
  <section class="border-b border-line">
    <Container as="div" class="py-20 sm:py-24">
      <Eyebrow>Design system</Eyebrow>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        {site.name}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
        The operating rules behind the portfolio. Written for people and for
        agents, hosted beside
        <a
          href={site.portfolioUrl}
          class="text-ink underline decoration-line underline-offset-4 hover:decoration-ink-muted"
        >
          aarondesign.rocks
        </a>.
      </p>
    </Container>
  </section>

  {
    sections.map((section) => {
      const entries = docs.filter((entry) => entry.id.startsWith(`${section.id}/`));
      return (
        <section class="border-b border-line">
          <Container class="py-16">
            <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              {section.label}
            </h2>
            {entries.length === 0 ? (
              <p class="mt-4 text-sm text-ink-subtle">Nothing published here yet.</p>
            ) : (
              <div class="mt-8 grid grid-cols-1 gap-grid sm:grid-cols-2">
                {entries.map((entry) => (
                  <Surface
                    href={`/${entry.id}`}
                    interactive
                    class="block p-6"
                  >
                    <h3 class="text-lg font-semibold tracking-tight text-ink">
                      {entry.data.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                      {entry.data.description}
                    </p>
                  </Surface>
                ))}
              </div>
            )}
          </Container>
        </section>
      );
    })
  }
</SiteLayout>
