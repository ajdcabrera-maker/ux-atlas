---
import { getCollection, render } from 'astro:content';
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const section = entry.id.split('/')[0]?.replace(/-/g, ' ') ?? 'Docs';
---

<SiteLayout title={`${entry.data.title} · ${site.name}`} description={entry.data.description}>
  <article class="border-b border-line">
    <Container as="div" class="py-16 sm:py-20">
      <Eyebrow>{section}</Eyebrow>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
        {entry.data.description}
      </p>
      <div class="docs-prose mt-12 max-w-3xl">
        <Content />
      </div>
    </Container>
  </article>
</SiteLayout>
