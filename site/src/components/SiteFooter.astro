---
import { site } from '../lib/site';
import { getSiteNav } from '../lib/skill-nav';
import Container from '../ds/Container.astro';

const year = new Date().getFullYear();
const { links } = await getSiteNav();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class="border-t border-line">
  <Container
    class="flex flex-col gap-8 py-12 sm:flex-row sm:items-end sm:justify-between"
  >
    <div class="space-y-3">
      <p class="text-sm font-medium text-ink">{site.name}</p>
      <p class="max-w-sm text-sm leading-relaxed text-ink-subtle">
        An open-source library of foundational AI skills for UX design.
      </p>
      <p class="text-xs text-ink-subtle">© {year} Aaron Cabrera</p>
    </div>

    {
      links.length > 0 && (
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-4 text-sm">
          {links.map((link) => (
            <a
              href={link.href}
              class="flex min-h-11 items-center text-ink-muted transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {link.label}
            </a>
          ))}
          {site.footer.map((link) => {
            const current = path === link.href;
            return (
              <a
                href={link.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                  current ? 'text-ink' : 'text-ink-muted',
                ]}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      )
    }
  </Container>
</footer>
