---
import { getSkillNav } from '../lib/skill-nav';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const sections = await getSkillNav();
---

<nav aria-label="Skills" class="md:sticky md:top-24">
  <p class="text-sm font-medium uppercase tracking-[0.14em] text-ink-subtle">Skills</p>
  <ul class="mt-4 space-y-6">
    {
      sections.map((section) => (
        <li>
          <p class="text-sm font-medium text-ink">{section.label}</p>
          <ul class="mt-2 space-y-1">
            {section.skills.map((skill) => {
              const active = current === skill.id;
              return (
                <li>
                  <a
                    href={skill.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block min-h-11 rounded-control px-2 py-2.5 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                      active
                        ? 'bg-canvas-elevated text-ink'
                        : 'text-ink-muted hover:bg-canvas-elevated hover:text-ink',
                    ]}
                  >
                    {skill.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>
</nav>
