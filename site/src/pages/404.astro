---
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';
---

<SiteLayout title={`Not found · ${site.name}`} description="That page is not in UX Atlas.">
  <Container class="py-24">
    <Eyebrow>404</Eyebrow>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
      Page not found
    </h1>
    <p class="mt-6 text-lg text-ink-muted">This page is not on the site.</p>
    <p class="mt-6 flex flex-col items-start gap-1">
      <a
        href="/"
        class="inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Back home
      </a>
      <a
        href="/install"
        class="inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Install the package
      </a>
      <a
        href="/download"
        class="inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Download a project folder
      </a>
    </p>
  </Container>
</SiteLayout>
