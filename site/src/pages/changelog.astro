---
import { getEntry, render } from 'astro:content';
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';

const entry = await getEntry('changelog', 'changelog');
if (!entry) {
  throw new Error('Add CHANGELOG.md at the repository root.');
}
const { Content } = await render(entry);
---

<SiteLayout
  title={`Changelog · ${site.name}`}
  description="What changed in UX Atlas. Newest first."
>
  <div class="border-b border-line">
    <Container class="py-16 md:py-20">
      <Eyebrow>Site</Eyebrow>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        Changelog
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
        What changed in UX Atlas. Newest first.
      </p>
      <div class="docs-prose mt-12 max-w-3xl">
        <Content />
      </div>
    </Container>
  </div>
</SiteLayout>
