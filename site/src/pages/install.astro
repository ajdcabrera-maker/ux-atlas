---
import { site } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../ds/Container.astro';
import Eyebrow from '../ds/Eyebrow.astro';

const exitClass =
  'inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<SiteLayout
  title={`Install the package · ${site.name}`}
  description="A design layer for an agent process you already have."
>
  <div class="border-b border-line">
    <Container class="py-16 md:py-20">
      <Eyebrow>Use Atlas</Eyebrow>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        Install the package
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
        A design layer for an agent process you already have.
      </p>
      <pre class="mt-8 max-w-2xl overflow-x-auto rounded-card border border-line bg-canvas-elevated/50 p-5 text-sm text-ink"><code>npm install github:ajdcabrera-maker/ux-atlas</code></pre>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
        The install adds a pointer to the end of AGENTS.md and CLAUDE.md. Those files then point
        at the skills in node_modules. Run npm update ux-atlas for a newer copy. A DESIGN.md at the
        project root stays in place.
      </p>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-muted">
        If a simple prompt is not yet something Atlas can act on.
      </p>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
        Adds the brief skill to the project. The skill translates a prompt into an actionable task for UX Atlas. This command also tells AGENTS.md to read the brief skill first.
      </p>
      <pre class="mt-4 max-w-2xl overflow-x-auto rounded-card border border-line bg-canvas-elevated/50 p-5 text-sm text-ink"><code>npx ux-atlas brief</code></pre>
      <p class="mt-6">
        <a href="/design-systems" class={exitClass}>Choose a design system</a>
      </p>
      <p class="mt-6">
        <a href="/download" class={exitClass}>Download a project folder</a>
      </p>
    </Container>
  </div>
</SiteLayout>
